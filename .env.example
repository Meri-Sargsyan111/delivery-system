# Copy to .env (gitignored, never commit real values) in this same directory - Docker
# Compose auto-loads it for ${VAR} substitution in docker-compose.yml.

# Optional but strongly recommended for any real deployment - both fall back to a known
# dev-only default (postgres/postgres, admin@delivery.com/Admin@12345) if unset, which is
# fine for local MODE B/A testing but must be overridden here for a real server so the DB
# and the bootstrapped ROLE_ADMIN account aren't running on publicly-known credentials.
POSTGRES_PASSWORD=change-me-in-production
ADMIN_EMAIL=admin@delivery.com
ADMIN_PASSWORD=change-me-in-production

# Shared secret used for every internal service-to-service call in this system (see
# InternalServiceTokenFilter in courier-service and order-service) - order-service
# presents it to courier-service's reserve endpoint, and payment-service presents it to
# order-service's POST /orders/internal/from-payment endpoint. Falls back to a known
# dev-only default if unset - must be overridden here for a real deployment, same as the
# values above.
INTERNAL_SERVICE_TOKEN=change-me-in-production

# ==========================================================
# Payment platform (payment-service) - see this project's Part 3 final report for full
# details. Leave STRIPE_SECRET_KEY/STRIPE_WEBHOOK_SECRET empty to disable real card
# payments (Stripe-backed VISA/MASTERCARD requests will fail cleanly with a clear log
# message rather than silently succeeding). Never commit real values here.
# ==========================================================

# From https://dashboard.stripe.com/test/apikeys (test/sandbox mode - see the final
# report for why this can't be a real production credential for an AMD-priced business
# without a currency/provider change).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# From https://dashboard.stripe.com/test/webhooks after registering this deployment's
# POST /payments/webhook/stripe URL as an endpoint - required for webhook signature
# verification (payment-service refuses to trust an unsigned/wrongly-signed webhook).
STRIPE_WEBHOOK_SECRET=

# Rocket Line - not yet integrated (see RocketLinePaymentProviderAdapter). Leave
# ROCKET_LINE_ENABLED=false until real API documentation/credentials are available;
# setting it to true without a real base-url/api-key will not work, every call is
# stubbed to fail clearly rather than silently.
ROCKET_LINE_ENABLED=false
ROCKET_LINE_BASE_URL=
ROCKET_LINE_API_KEY=
ROCKET_LINE_WEBHOOK_SECRET=
