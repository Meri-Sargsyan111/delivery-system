# Copy to .env (gitignored, never commit real values) in this same directory - Docker
# Compose auto-loads it for ${VAR} substitution in docker-compose.yml.
#
# Used by auth-service (welcome email on registration) and notification-service
# (order/delivery alert email). Gmail SMTP needs a Google Account with 2FA enabled and an
# App Password (not the account's login password) - https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Optional - notification-service's fixed ops-alert recipient. Defaults to a placeholder
# in application.yml if unset.
MAIL_RECIPIENT=ops@example.com
