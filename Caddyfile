# Plain-HTTP reverse proxy, for deploying by bare IP with no domain yet. Once a domain is
# pointed at the server, replace ":80" with the domain name so Caddy provisions Let's
# Encrypt TLS automatically, then re-run `docker compose up -d caddy`.
#
# Known backend API/WebSocket path prefixes go to api-gateway (list mirrors
# backend/api-gateway/src/main/resources/application.yml's route predicates exactly);
# everything else (the Angular app shell, its JS/CSS bundles, and any of its client-side
# routes) falls through to the frontend container, whose own nginx handles the SPA
# fallback for deep-link refreshes.
#
# Path alone is not enough: several Angular routes share a name with a backend API path
# prefix (/orders, /tracking, /notifications), so "GET /orders" is genuinely ambiguous -
# it means "user refreshed the Orders page" from the browser address bar, or "Angular's
# own HttpClient calling the orders API" from already-loaded JS. Real browser top-level
# navigations (address bar, refresh, back/forward) always send an Accept header led by
# text/html; Angular's HttpClient (plain XHR, no Accept override) sends Accept: */*.
# Checking that first, before the path-based API matcher, resolves the ambiguity
# correctly in both directions.
#
# NOTE: an earlier version of this fix matched on Sec-Fetch-Dest: document instead.
# That header is only sent by browsers on secure contexts (HTTPS, or http://localhost /
# 127.0.0.1) - this deployment is plain HTTP to a bare public IP, which Chromium does NOT
# treat as a secure context, so it silently omitted Sec-Fetch-Dest entirely and that
# matcher never fired in production (confirmed via tcpdump on the server showing the
# header genuinely absent from the wire, despite curl -H tests passing). Accept has no
# such restriction - it is sent on every request regardless of scheme.
:80 {
	@navigation header Accept *text/html*
	handle @navigation {
		reverse_proxy frontend:80
	}

	@api path /auth /auth/* /orders /orders/* /courier /courier/* /tracking /tracking/* /notifications /notifications/* /chat /chat/* /ws /ws/* /ws-location /ws-location/* /ws-chat /ws-chat/*
	handle @api {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy frontend:80
	}
}
